{
  "name": "trustyshelf",
  "productName": "TrustyShelf",
  "version": "1.5.1+0",
  "description": "TV-style launcher for emulators, Steam and media apps",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:rust": "node scripts/build-rust.js",
    "prestart": "node scripts/build-rust.js",
    "predist": "node scripts/build-rust.js",
    "predist:linux": "node scripts/build-rust.js",
    "start": "electron .",
    "windowed": "electron . --windowed",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.trustyshelf",
    "productName": "TrustyShelf",
    "files": [
      "main.js",
      "preload.js",
      "preload-home.js",
      "preload-wum.js",
      "main/**",
      "shared/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "renderer/app-icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "renderer/app-icon.png",
      "category": "Game",
      "desktop": { "entry": { "Name": "(T)rustyShelf" } },
      "synopsis": "TV-style launcher for emulators and Steam",
      "artifactName": "TrustyShelf-${version}-linux.${ext}"
    },
    "artifactBuildStarted": "scripts/linux-wrapper.js",
    "asar": true,
    "asarUnpack": [
      "main/lbindex.js",
      "main/bin/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  }
}
